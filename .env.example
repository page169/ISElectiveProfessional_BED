# Copy to .env for local use. NEVER commit the real .env file.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides
# Model name. Default is the alias gemini-flash-latest (Gemini 2.5 models were shut down in Oct 2026).
# Run `python scripts/check_setup.py` to list the models your key can use.
# GEMINI_MODEL=gemini-flash-latest
